{
	"name": "my-next-film-list",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "prisma generate && next build",
		"db:push": "prisma db push",
		"dev": "next dev --turbopack",
		"dev-local:prisma:studio": "dotenv -e .env.local prisma studio --browser none",
		"dev-local:seed": "dotenv -e .env.local prisma db seed",
		"dev-local:docker": "docker compose --env-file .env.local -f 'docker/mongodb/docker-compose.yml' up -d --build",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"postinstall": "prisma generate",
		"lint": "next lint",
		"lint-staged": "pnpm dlx lint-staged",
		"prisma:generate": "prisma generate",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"resolutions": {
		"@typescript-eslint/typescript-estree": "^8.13.0",
		"@types/react": "npm:types-react@19.0.0-rc.1",
