{
	"name": "my-next-film-list",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "prisma generate && next build",
		"db:push": "prisma db push",
		"dev": "next dev --turbopack",
		"dev-local:docker": "docker compose --env-file .env.local -f 'docker/mongodb/docker-compose.yml' up -d --build",
		"dev-local:prisma:studio": "dotenv -e .env.local prisma studio --browser none",
		"dev-local:seed": "dotenv -e .env.local prisma db seed",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"postinstall": "prisma generate",
		"lint": "next lint",
		"lint-staged": "pnpm dlx lint-staged",
		"prisma:generate": "prisma generate",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@auth0/nextjs-auth0": "4.0.1",
		"@headlessui/react": "^2.2.0",
		"@heroicons/react": "^2.2.0",
		"@prisma/client": "^6.3.1",
		"@radix-ui/react-avatar": "^1.1.3",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-navigation-menu": "^1.2.5",
		"@radix-ui/react-slot": "^1.1.2",
		"@sentry/nextjs": "^9.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/react-table": "^8.21.2",
		"body-scroll-lock": "4.0.0-beta.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.475.0",
		"next": "15.1.7",
		"next-themes": "^0.4.4",
		"prisma": "^6.3.1",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-hook-form": "^7.54.2",
		"swr": "^2.3.2",
		"tailwind-merge": "^3.0.1",
		"tailwind-scrollbar-hide": "^2.0.0",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-radix": "^4.0.1",
		"zod": "^3.24.2",
		"zod-error": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@svgr/webpack": "^8.1.0",
		"@types/body-scroll-lock": "^3.1.2",
		"@types/eslint__eslintrc": "^2.1.2",
		"@types/node": "^22.13.4",
		"@types/react": "19.0.10",
		"@types/react-dom": "19.0.4",
		"@typescript-eslint/parser": "^8.24.1",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.20.1",
		"eslint-config-next": "15.1.7",
		"jiti": "^2.4.2",
		"postcss": "^8.5.2",
		"prettier": "^3.5.1",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.0.7",
		"tsx": "^4.19.2",
		"typescript": "^5.6.2"
	},
	"overrides": {
		"@tanstack/react-virtual": {
			"react": "19.0.0",
			"react-dom": "19.0.0"
		}
	},
	"packageManager": "pnpm@10.4.1",
	"engines": {
		"node": "^20.10.0",
		"pnpm": "^10.4.1"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	}
}